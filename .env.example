# Copy to .env and edit. Never commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Secret admin URL (no leading slash, trailing slash required)
ADMIN_URL=manage-console/

# Email (use SMTP in production; console prints emails in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Sai Samarth Holidays <holidays@saisamarthholidays.in>

# WhatsApp Cloud API (Meta). Leave blank in development: messages are logged instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Optional approved templates (needed for business-initiated messages outside the 24h window).
# Template body variables are sent in this order: name, tour title, tour code, booking ref, travel date, total
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_ENQUIRY=

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback: http://127.0.0.1:8000/auth/google/login/callback/
